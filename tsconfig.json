{
	"extends": "@iamnapo/tsconfig",
	"compilerOptions": {
		"allowJs": false,
		"noEmit": true,
		"incremental": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"plugins": [{ "name": "next" }],
		"moduleResolution": "bundler",
		"module": "esnext",
		"paths": { "#components/*": ["./src/components/*"], "#hooks/*": ["./src/hooks/*"] }
	},
	"include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
